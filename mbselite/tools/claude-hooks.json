{
  "PostToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit|Bash",
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/mbselite/tools/on-spec-change.sh",
          "timeout": 240,
          "statusMessage": "Rebuilding mbselite spec site…"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/mbselite/tools/session-hint.sh",
          "timeout": 20
        }
      ]
    }
  ]
}
